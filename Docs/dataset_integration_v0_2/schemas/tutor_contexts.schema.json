{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "approval_status",
    "candidate_teaching_move",
    "candidate_tutor_response",
    "chapter",
    "context",
    "dialogue_id",
    "id",
    "misconception_id",
    "mode",
    "problem_id",
    "source_origin",
    "split",
    "trajectory",
    "variant_family"
  ],
  "properties": {
    "approval_status": {
      "type": "string"
    },
    "candidate_teaching_move": {
      "type": "string"
    },
    "candidate_tutor_response": {
      "type": "string"
    },
    "chapter": {
      "type": "string"
    },
    "context": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "content",
          "role"
        ],
        "properties": {
          "content": {
            "type": "string"
          },
          "role": {
            "type": "string"
          }
        }
      }
    },
    "dialogue_id": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "misconception_id": {
      "type": "string"
    },
    "mode": {
      "type": "string"
    },
    "problem_id": {
      "type": "string"
    },
    "source_origin": {
      "type": "string"
    },
    "split": {
      "type": "string"
    },
    "trajectory": {
      "type": "string"
    },
    "variant_family": {
      "type": "string"
    }
  }
}
