{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "chapter",
    "context",
    "creation_date",
    "curriculum_scope",
    "expected_route",
    "generator_version",
    "human_annotation_required",
    "id",
    "misconception_id",
    "paraphrase_family",
    "primary_intent",
    "raw_student_text",
    "review_status",
    "reviewer_id",
    "source_origin",
    "split",
    "style",
    "tags",
    "variant_family"
  ],
  "properties": {
    "chapter": {
      "type": "string"
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "active_problem",
        "mode",
        "previous_tutor_prompt",
        "problem_id"
      ],
      "properties": {
        "active_problem": {
          "type": "string"
        },
        "mode": {
          "type": "string"
        },
        "previous_tutor_prompt": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "problem_id": {
          "type": "string"
        }
      }
    },
    "creation_date": {
      "type": "string"
    },
    "curriculum_scope": {
      "type": "string"
    },
    "expected_route": {
      "type": "string"
    },
    "generator_version": {
      "type": "string"
    },
    "human_annotation_required": {
      "type": "boolean"
    },
    "id": {
      "type": "string"
    },
    "misconception_id": {
      "type": "string"
    },
    "paraphrase_family": {
      "type": "string"
    },
    "primary_intent": {
      "type": "string"
    },
    "raw_student_text": {
      "type": "string"
    },
    "review_status": {
      "type": "string"
    },
    "reviewer_id": {
      "type": "null"
    },
    "source_origin": {
      "type": "string"
    },
    "split": {
      "type": "string"
    },
    "style": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "variant_family": {
      "type": "string"
    }
  }
}
