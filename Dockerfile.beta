FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1
WORKDIR /app
COPY pyproject.toml README.md ./
# Install pinned runtime dependencies separately so code edits reuse this layer.
RUN python -c "import tomllib,subprocess,sys; p=tomllib.load(open('pyproject.toml','rb'))['project']; subprocess.check_call([sys.executable,'-m','pip','install',*p['dependencies'],*p['optional-dependencies']['api']])"
COPY src ./src
COPY config ./config
COPY content ./content
RUN pip install --no-deps -e . && useradd --create-home --uid 10001 tutor && mkdir -p /app/var && chown tutor:tutor /app/var
USER tutor
ENV TUTOR_BETA_DATA_DIR=/app/var/beta TUTOR_BETA_LIVE=0 TUTOR_LLM=stub PORT=8000
VOLUME ["/app/var"]
EXPOSE 8000
HEALTHCHECK --interval=15s --timeout=5s --start-period=40s --retries=5 CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health',timeout=4)"
CMD ["python", "-m", "socrates_beta.hosted", "serve"]
