# Copy this file to .env in the repository root and put your own course key after LLM_API_KEY=.
# .env is in .gitignore: never commit it, and never share your key (each member has their own).
# Then check it with: tutor check-llm
# Without a key the POC runs on a deterministic stub.
LLM_API_KEY=

# OpenRouter is the default. Models are set in config/app.toml, so each run's config hash records them;
# uncomment these only to try something for a moment.
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=openai/gpt-4.1-mini

# Set to "stub" to force the stub even when a key is present.
# Docker Compose defaults to the stub; set TUTOR_LLM=auto here to let the API container use your key.
# TUTOR_LLM=stub

# API access tokens (token:role:id, comma-separated). Unset = the public development tokens
# dev-student-a, dev-student-b and dev-teacher. Local development values only; see Docs/deploy/README.md.
# TUTOR_API_TOKENS=local-student:student:L-DEMO,local-teacher:teacher:T-DEMO

# Optional registered-practice language adapter; 0 keeps template hints.
# Selecting 1 does not authorize source-excerpt transfer to an external provider.
# Keep TUTOR_LLM=stub for offline checks; use live generation only after transfer approval.
TUTOR_CONTEXTUAL_HINTS=0

# Vercel full beta: values belong only in Vercel environment settings.
DATABASE_URL=
TUTOR_BROWSER_SECRET=
TUTOR_PUBLIC_ORIGIN=https://socratic-tutor-beta.vercel.app
TUTOR_BETA_LIVE=0
